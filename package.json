{
  "name": "@fm-budget-control/fm-budget-control-core",
  "version": "1.0.0",
  "description": "Hexagonal architecture domain primitives for fm-budget-control",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./user/application": {
      "types": "./dist/user/application/use-cases/index.d.ts",
      "import": "./dist/user/application/use-cases/index.js"
    },
    "./user/ports": {
      "types": "./dist/user/application/ports/index.d.ts",
      "import": "./dist/user/application/ports/index.js"
    },
    "./kernel/ports": {
      "types": "./dist/kernel/application/ports/index.d.ts",
      "import": "./dist/kernel/application/ports/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && publint",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:types": "tsc --project tsconfig.type-tests.json --noEmit && echo \"Type specs passed\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fm-budget-control/fm-budget-control-core.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "publint": "^0.3.21",
    "semantic-release": "^25.0.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
